# ===========================================
# Hospital App — Docker Compose Environment
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# Required — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET

# Database
DB_USER=hospital
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_NAME=hospital_db

# CORS — comma-separated origins
ALLOWED_ORIGINS=https://dash.zuhudo.cc.cd,https://zuhudo.cc.cd

# Dashboard API URL
VITE_API_URL=https://api.zuhudo.cc.cd
