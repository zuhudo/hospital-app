---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="About Us">
  <section class="pt-32 section-padding bg-gradient-to-br from-primary-600 to-primary-800 text-white">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">About MediCare</h1>
      <p class="text-white/80 text-lg max-w-2xl mx-auto">
        Providing compassionate, world-class healthcare since 1995
      </p>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Our Story</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Founded in 1995, MediCare Hospital has grown from a small clinic to one of the region's
            most trusted healthcare institutions. Our commitment to excellence, innovation, and
            compassionate care has made us the preferred choice for thousands of families.
          </p>
          <p class="text-gray-600 leading-relaxed mb-4">
            With over 50 specialist doctors, 25 departments, and state-of-the-art medical technology,
            we provide comprehensive healthcare services under one roof.
          </p>
          <p class="text-gray-600 leading-relaxed">
            Our mission is simple: to make quality healthcare accessible to everyone while maintaining
            the highest standards of medical excellence.
          </p>
        </div>
        <div class="bg-primary-50 rounded-3xl p-8">
          <div class="grid grid-cols-2 gap-6">
            <div class="bg-white rounded-2xl p-6 text-center">
              <div class="text-3xl font-bold text-primary-600">25+</div>
              <div class="text-sm text-gray-500 mt-1">Years of Service</div>
            </div>
            <div class="bg-white rounded-2xl p-6 text-center">
              <div class="text-3xl font-bold text-primary-600">50+</div>
              <div class="text-sm text-gray-500 mt-1">Specialist Doctors</div>
            </div>
            <div class="bg-white rounded-2xl p-6 text-center">
              <div class="text-3xl font-bold text-primary-600">10k+</div>
              <div class="text-sm text-gray-500 mt-1">Patients Served</div>
            </div>
            <div class="bg-white rounded-2xl p-6 text-center">
              <div class="text-3xl font-bold text-primary-600">15+</div>
              <div class="text-sm text-gray-500 mt-1">Awards Won</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-3 gap-8">
        <div class="card text-center">
          <div class="w-16 h-16 bg-primary-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Our Mission</h3>
          <p class="text-gray-500 text-sm">To provide accessible, high-quality healthcare with compassion and integrity.</p>
        </div>
        <div class="card text-center">
          <div class="w-16 h-16 bg-accent-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-accent-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Our Vision</h3>
          <p class="text-gray-500 text-sm">To be the leading healthcare institution known for innovation and patient satisfaction.</p>
        </div>
        <div class="card text-center">
          <div class="w-16 h-16 bg-green-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Our Values</h3>
          <p class="text-gray-500 text-sm">Integrity, compassion, excellence, and continuous improvement in everything we do.</p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
