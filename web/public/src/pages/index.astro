---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import DoctorCard from '../components/DoctorCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';

const services = [
  {
    icon: '<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>',
    title: 'Cardiology',
    description: 'Comprehensive heart care with advanced diagnostics and treatment options for all cardiac conditions.',
    color: 'primary',
  },
  {
    icon: '<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>',
    title: 'Neurology',
    description: 'Expert neurological care for brain, spine, and nervous system disorders with cutting-edge technology.',
    color: 'accent',
  },
  {
    icon: '<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>',
    title: 'Pediatrics',
    description: 'Specialized healthcare for infants, children, and adolescents in a warm and friendly environment.',
    color: 'green',
  },
  {
    icon: '<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>',
    title: 'Laboratory',
    description: 'State-of-the-art diagnostic laboratory with fast and accurate test results for better treatment.',
    color: 'purple',
  },
  {
    icon: '<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>',
    title: 'Emergency',
    description: '24/7 emergency services with rapid response teams and fully equipped emergency rooms.',
    color: 'orange',
  },
  {
    icon: '<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>',
    title: 'Orthopedics',
    description: 'Expert bone and joint care with minimally invasive surgical techniques and rehabilitation.',
    color: 'pink',
  },
];

const doctors = [
  { name: 'Dr. Sarah Johnson', specialization: 'Cardiologist', rating: 4.8, experience: '15 years experience' },
  { name: 'Dr. Michael Chen', specialization: 'Neurologist', rating: 4.9, experience: '12 years experience' },
  { name: 'Dr. Emily Williams', specialization: 'Pediatrician', rating: 4.7, experience: '8 years experience' },
  { name: 'Dr. James Brown', specialization: 'Orthopedic Surgeon', rating: 4.6, experience: '20 years experience' },
];

const testimonials = [
  {
    name: 'Maria Garcia',
    role: 'Patient',
    testimonial: 'The care I received at MediCare was exceptional. The doctors were thorough and the staff was incredibly supportive throughout my treatment.',
    rating: 5,
  },
  {
    name: 'Robert Wilson',
    role: 'Patient',
    testimonial: 'Outstanding cardiology department. Dr. Johnson saved my life with her quick diagnosis and expert treatment. Forever grateful!',
    rating: 5,
  },
  {
    name: 'Lisa Chen',
    role: 'Patient',
    testimonial: 'Best pediatric care for my children. The doctors are patient, kind, and truly care about their young patients.',
    rating: 4,
  },
];
---

<MainLayout title="Home">
  <Hero />

  <!-- Services Section -->
  <section class="section-padding bg-white" id="services">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-primary-600 font-semibold text-sm uppercase tracking-wider">Our Services</span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2">
          Comprehensive Healthcare Solutions
        </h2>
        <p class="text-gray-500 mt-4 max-w-2xl mx-auto">
          We offer a wide range of medical services to meet all your healthcare needs under one roof.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map(service => <ServiceCard {...service} />)}
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section-padding bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="text-primary-600 font-semibold text-sm uppercase tracking-wider">Why Choose Us</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2 mb-6">
            Trusted Healthcare For Your Family
          </h2>
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 mb-1">Advanced Technology</h3>
                <p class="text-sm text-gray-500">State-of-the-art medical equipment and cutting-edge treatment methods.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-accent-100 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-accent-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 mb-1">Expert Doctors</h3>
                <p class="text-sm text-gray-500">Board-certified physicians with years of experience in their specialties.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 mb-1">24/7 Availability</h3>
                <p class="text-sm text-gray-500">Round-the-clock emergency services and patient support.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gradient-to-br from-primary-500 to-primary-700 rounded-3xl p-8 text-white">
          <h3 class="text-2xl font-bold mb-6">Quick Stats</h3>
          <div class="grid grid-cols-2 gap-6">
            <div class="bg-white/10 backdrop-blur rounded-2xl p-6">
              <div class="text-4xl font-bold">50+</div>
              <div class="text-white/70 text-sm mt-1">Expert Doctors</div>
            </div>
            <div class="bg-white/10 backdrop-blur rounded-2xl p-6">
              <div class="text-4xl font-bold">10k+</div>
              <div class="text-white/70 text-sm mt-1">Happy Patients</div>
            </div>
            <div class="bg-white/10 backdrop-blur rounded-2xl p-6">
              <div class="text-4xl font-bold">25+</div>
              <div class="text-white/70 text-sm mt-1">Departments</div>
            </div>
            <div class="bg-white/10 backdrop-blur rounded-2xl p-6">
              <div class="text-4xl font-bold">15+</div>
              <div class="text-white/70 text-sm mt-1">Awards Won</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Doctors Section -->
  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-primary-600 font-semibold text-sm uppercase tracking-wider">Our Team</span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2">
          Meet Our Expert Doctors
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {doctors.map(doctor => <DoctorCard {...doctor} />)}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section-padding bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-primary-600 font-semibold text-sm uppercase tracking-wider">Testimonials</span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2">
          What Our Patients Say
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {testimonials.map(t => <TestimonialCard {...t} />)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-gradient-to-r from-primary-600 to-primary-800 text-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        Ready to Take the First Step?
      </h2>
      <p class="text-white/80 mb-8 text-lg">
        Book an appointment today and experience the best healthcare services.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn-primary bg-white text-primary-600 hover:bg-gray-100">
          Book Appointment
        </a>
        <a href="tel:+1234567890" class="btn-secondary border-white text-white hover:bg-white/10">
          Call Us Now
        </a>
      </div>
    </div>
  </section>
</MainLayout>
