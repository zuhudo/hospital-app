---
interface Props {
  name: string;
  specialization: string;
  rating: number;
  experience: string;
}

const { name, specialization, rating, experience } = Astro.props;
---

<div class="card group text-center">
  <div class="w-24 h-24 mx-auto bg-gradient-to-br from-primary-100 to-accent-100 rounded-full flex items-center justify-center mb-4">
    <svg class="w-12 h-12 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
    </svg>
  </div>
  <h3 class="text-lg font-semibold text-gray-900 mb-1">{name}</h3>
  <p class="text-sm text-primary-600 font-medium mb-2">{specialization}</p>
  <p class="text-xs text-gray-500 mb-3">{experience}</p>
  <div class="flex items-center justify-center gap-1">
    {Array.from({ length: 5 }).map((_, i) => (
      <svg
        class:list={['w-4 h-4', i < Math.floor(rating) ? 'text-yellow-400' : 'text-gray-200']}
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    ))}
    <span class="text-sm text-gray-500 ml-1">({rating})</span>
  </div>
  <a href="/contact" class="btn-primary w-full mt-4 text-sm">
    Book Appointment
  </a>
</div>
