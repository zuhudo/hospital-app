---
---

<section class="relative min-h-screen flex items-center bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800 overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-20 left-10 w-72 h-72 bg-white rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-accent-400 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div class="text-white">
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2 mb-6">
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          <span class="text-sm font-medium">24/7 Emergency Services Available</span>
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight mb-6">
          Your Health Is Our
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-300 to-accent-300">
            Top Priority
          </span>
        </h1>

        <p class="text-lg text-white/80 mb-8 max-w-xl leading-relaxed">
          Experience world-class healthcare with our team of expert doctors, state-of-the-art facilities,
          and compassionate patient care. Your journey to wellness starts here.
        </p>

        <div class="flex flex-wrap gap-4">
          <a href="/contact" class="btn-primary bg-white text-primary-600 hover:bg-gray-100">
            <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Book Appointment
          </a>
          <a href="/services" class="btn-secondary border-white text-white hover:bg-white/10">
            Our Services
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-6 mt-12 pt-8 border-t border-white/20">
          <div>
            <div class="text-3xl font-bold">50+</div>
            <div class="text-sm text-white/60">Expert Doctors</div>
          </div>
          <div>
            <div class="text-3xl font-bold">10k+</div>
            <div class="text-sm text-white/60">Happy Patients</div>
          </div>
          <div>
            <div class="text-3xl font-bold">25+</div>
            <div class="text-sm text-white/60">Years Experience</div>
          </div>
        </div>
      </div>

      <!-- Hero Image/Illustration -->
      <div class="hidden lg:flex justify-center">
        <div class="relative">
          <div class="w-[400px] h-[400px] bg-white/10 rounded-3xl backdrop-blur-sm border border-white/20 flex items-center justify-center">
            <div class="text-center">
              <svg class="w-32 h-32 mx-auto text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                  d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
              <p class="text-white/60 mt-4 text-lg font-medium">Healthcare Excellence</p>
            </div>
          </div>
          <!-- Floating cards -->
          <div class="absolute -top-4 -right-4 bg-white rounded-xl p-4 shadow-xl animate-bounce">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-800">Appointment</p>
                <p class="text-xs text-gray-500">Confirmed!</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
